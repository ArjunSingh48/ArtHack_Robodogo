# --- Mode -------------------------------------------------------------
# simulation  : no hardware, mock robot (default, safe)
# installation: real exhibition; real robot only if ROBOT_MODEL=go2 AND an operator arms it
APP_MODE=simulation
DEFAULT_LANGUAGE=en

# --- Robot ------------------------------------------------------------
# mock | go2 (direct Unitree SDK) | zhaw_bridge (via ZHAW go2_main bridge — recommended in the lab)
ROBOT_MODEL=mock
# ZHAW go2_main bridge (python -m go2_bridge) — only for ROBOT_MODEL=zhaw_bridge
ZHAW_BRIDGE_HOST=localhost
ZHAW_BRIDGE_CMD_PORT=5555
ZHAW_BRIDGE_PUB_PORT=5556
# Network interface connected to the robot, e.g. enp3s0 / en7 (Go2 EDU, wired DDS)
ROBOT_NETWORK_INTERFACE=
# Hard gate. Even when true, an operator must /arm in Telegram before any motion.
ROBOT_MOTION_ENABLED=false
MOTION_COOLDOWN_SECONDS=8
MOTION_TIMEOUT_SECONDS=12
MIN_BATTERY_PERCENT=25
# Sport-state topic differs between models/firmware (rt/sportmodestate | rt/lf/sportmodestate)
GO2_STATE_TOPIC=rt/sportmodestate
GO2_LOWSTATE_TOPIC=rt/lowstate

# --- Telegram ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs, e.g. 123456789,987654321
TELEGRAM_OPERATOR_IDS=
# Bot username without @ (used to build QR deep links)
TELEGRAM_BOT_USERNAME=
PAIRING_TOKEN_TTL_MINUTES=10
SESSION_TTL_MINUTES=30

# --- Voice: OpenAI (one voice for the whole character) — docs/VOICE.md ----
# Only text is sent for speech; never images or body data. Empty key = text-only
# (cached performance narration still plays offline).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# Model names below are Azure deployment names
OPENAI_VOICE_PROVIDER=openai
# The ONE primary voice for narration, lines and conversation. Pick it with `itu voice audition`.
# Must work in both Realtime and GPT-Live: alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar
OPENAI_VOICE=marin
OPENAI_VOICE_LANGUAGE=en
# Scripted performance narration (pre-generated per cue: `itu show voice pregenerate`)
OPENAI_NARRATION_MODEL=gpt-realtime-2.1-mini
# Conversation windows during the show (push-to-talk). Off until tested with your mic/speaker.
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_ENABLE_LIVE_CONVERSATION=false
OPENAI_AUDIO_CACHE_ENABLED=true
# Free-play lines + `itu talk` (and the conversation fallback if GPT-Live is unavailable)
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Legacy name; used only when OPENAI_VOICE is empty
OPENAI_REALTIME_VOICE=marin
# Play the robot's voice on this laptop's speaker (ffplay/afplay/aplay)
LOCAL_AUDIO_PLAYBACK=false

# --- Talk mode (`itu talk`, live conversation) — see docs/TALK.md --------
TALK_MODEL=
TALK_VOICE=
# true for an open speaker (no self-echo); false only with headset / echo-cancelling speakerphone
TALK_HALF_DUPLEX=true
TALK_IDLE_SECONDS=45
TALK_MAX_SESSION_SECONDS=300
# names or numbers from `itu talk --list-devices`; empty = system default
TALK_INPUT_DEVICE=
TALK_OUTPUT_DEVICE=
STORY_PATH=./data/persona/story.md

# --- Vision -----------------------------------------------------------
# image:<path> | video:<path> | webcam[:index] | unitree | zhaw_bridge[:host[:port]]
CAMERA_SOURCE=webcam
POSE_MODEL_PATH=./models/pose_landmarker_lite.task

# --- Data -------------------------------------------------------------
ARTWORK_DATA_DIR=./data/artworks
DATABASE_PATH=./data/runtime/is_this_us.sqlite3
AUDIO_CACHE_DIR=./data/runtime/audio_cache
# Optional path to a .ttf/.otf serif font for memory cards
CARD_FONT_PATH=

# --- Memory archives (v0.3) -------------------------------------------
# art | meme | both | surprise — until a visitor chooses with /art /meme /surprise
DEFAULT_ARCHIVE=both
MEME_DATA_DIR=./data/memes
# Behaviors allowed at start-up (comma-separated). Empty = all except look_aside, peer,
# which stay off until tested on the robot and approved by an operator (/approve).
MOTION_ALLOWED_BEHAVIORS=
# A camera that can SEE the robot (NOT the robot's own camera), for consented imitation
# photos (diptych). Empty = feature off. e.g. webcam:1
IMITATION_CAMERA_SOURCE=

# --- Performance mode (`itu show`) — docs/PERFORMANCE.md -------------------
SHOW_DATA_DIR=./data/performance
# guided = the operator advances each chapter (jury); automatic = continuous narration
SHOW_MODE=guided
# terminal | web (projector page at http://SHOW_WEB_HOST:SHOW_WEB_PORT/)
SHOW_DISPLAY=terminal
SHOW_WEB_HOST=127.0.0.1
SHOW_WEB_PORT=8765
# Camera that sees the participant; empty = CAMERA_SOURCE
SHOW_CAMERA_SOURCE=
SHOW_CAMERA_MIRRORED=false
# Is there a chair? sitting | standing | any
SHOW_POSE_PREFERENCE=sitting
# Private chat or group that receives a CONFIRMED picture (numeric id; groups start with -100…)
SHOW_TELEGRAM_CHAT_ID=
# Participant photos + compositions are deleted after this many minutes
SHOW_PHOTO_RETENTION_MINUTES=60
SHOW_OUTPUT_DIR=./data/runtime/performance
# Robot cues in the script (`@motion`). Still needs every motion gate + operator /arm + --motion.
SHOW_MOTION_ENABLED=false
